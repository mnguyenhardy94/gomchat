NODE_ENV=production
# Thông tin app lấy từ Shopee Open Platform (open.shopee.com) > App Management
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Production: https://partner.shopeemobile.com
# Môi trường test của Shopee: xem mục Test trong console của app
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# Địa chỉ công khai (HTTPS) của server này. Shopee gọi redirect và push về đây.
PUBLIC_URL=https://inbox.example.com

# Đăng nhập cho nhân viên (HTTP Basic). Bắt buộc khi chạy production.
ADMIN_USER=admin
ADMIN_PASS=doi-mat-khau-nay

# Khóa mã hóa token Shopee khi lưu xuống đĩa (chuỗi ngẫu nhiên dài, giữ bí mật)
TOKEN_ENC_KEY=

PORT=3000
DATA_FILE=./data/db.json
# Chu kỳ quét dự phòng khi push không tới (giây)
POLL_SECONDS=60
# Đặt off chỉ khi đang gỡ lỗi push
PUSH_VERIFY=on
# Nếu URL push đăng ký trên Shopee khác PUBLIC_URL + /webhook/shopee thì ghi rõ ở đây
PUSH_URL=
